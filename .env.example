# awg-bot — шаблон секретов. Скопировать в /etc/awg-bot/env и заполнить.
#
# ЗДЕСЬ ТОЛЬКО СЕКРЕТЫ. Топология и настройки живут в conf/*.yaml — они попадают
# в git, а это нет (реальный .env игнорируется, в репозитории только шаблон).
#
# Боевой путь — /etc/awg-bot/env, его читает systemd (EnvironmentFile). Файл в
# корне проекта используется при ручном запуске; реальное окружение всегда
# приоритетнее файла.
#
# Права: chmod 600, владелец root. Внутри токен бота и пароли.

# ── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=

# Telegram ID администратора (число). Единственный, кто видит админ-меню.
ADMIN_ID=

# Шифрование резервных копий и почта в env не живут: задаются с экранов бота
# (⚙️ Настройки → Резервное копирование → Шифрование; ✉️ E-mail) и хранятся в БД.

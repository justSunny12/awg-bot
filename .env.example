# awg-bot — шаблон секретов. Скопировать в /etc/awg-bot/env и заполнить.
#
# ЗДЕСЬ ТОЛЬКО СЕКРЕТЫ. Топология и настройки живут в conf/*.yaml — они попадают
# в git, а это нет (реальный .env игнорируется, в репозитории только шаблон).
#
# Боевой путь — /etc/awg-bot/env, его читает systemd (EnvironmentFile). Файл в
# корне проекта используется при ручном запуске; реальное окружение всегда
# приоритетнее файла.
#
# Права: chmod 600, владелец root. Внутри токен бота и пароли.

# ── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather.
BOT_TOKEN=

# Telegram ID администратора (число). Единственный, кто видит админ-меню.
ADMIN_ID=

# ── Шифрование бэкапов (опционально) ────────────────────────────────────────
# Ровно ОДИН из двух режимов, не оба сразу. Пусто в обоих — бэкапы не шифруются.
# Заполняются скриптом tools/manage_secrets.py, восстановление —
# tools/restore_backup.py на awg-хосте.
#
# base64 32-байтного случайного ключа:
BACKUP_KEY=
# либо человеко-запоминаемая фраза (ключ выводится argon2id):
BACKUP_PASSPHRASE=

# ── Аварийный выход из приостановки письмом (опционально) ───────────────────
# Клиент, запертый в паузе (Telegram доступен только через этот VPN), присылает
# одноразовый код письмом — бот опрашивает ящик исходяще, портов не открываем.
# Хосты и адрес-алиас задаются в conf/email.yaml, здесь только креды.
# Пусто — функция спит.
EMAIL_RESUME_LOGIN=
EMAIL_RESUME_PASSWORD=

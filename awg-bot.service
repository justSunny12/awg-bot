# Справочный образец ДЛЯ ДОКЕРНОГО режима. Боевой юнит генерит install_unit
# в awg-bot.sh — при docker.runtime: host он выпускает его без строк про
# docker, иначе бота нельзя было бы отвязать от ненужной ему службы.
[Unit]
Description=AmneziaWG Telegram bot
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# Бот работает от root: правит iptables и конфиг awg.
User=root
WorkingDirectory=/opt/awg-bot
# Точка входа — пакет: python -m awgbot (нужен cwd=WorkingDirectory, где лежит awgbot/).
ExecStart=/opt/awg-bot/venv/bin/python -m awgbot
Restart=on-failure
RestartSec=5
# Секреты config читает сам из /etc/awg-bot/env; для ручного запуска — можно и так:
# EnvironmentFile=/etc/awg-bot/env

[Install]
WantedBy=multi-user.target
